{
  "name": "sistema-gestion-iglesia",
  "version": "0.1.0",
  "description": "Sistema web para administrar miembros, asistencias, eventos, ministerios, donaciones y anuncios de una iglesia",
  "main": "src/app.js",
  "private": true,
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/app.js",
    "dev": "nodemon src/app.js",
    "db:reset": "node --disable-warning=ExperimentalWarning scripts/db-reset.js"
  },
  "nodemonConfig": {
    "execMap": { "js": "node --disable-warning=ExperimentalWarning" },
    "ext": "js,ejs,sql,json",
    "ignore": ["data/*", "public/*"]
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.9",
    "ejs": "^7.0.2",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "express-session": "^1.19.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
