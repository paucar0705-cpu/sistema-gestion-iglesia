<%
  const primerSegmento = (rutaActual || '').split('/').filter(Boolean)[0];
  const entradaMenu = menu.find(([clave]) => clave === primerSegmento);
  const esPanel = entradaMenu && entradaMenu[1].ruta === SECCIONES.panel.ruta;
%>
<%- include('partials/header', { titulo }) %>
<section class="tarjeta">
  <h1><%= titulo %></h1>
  <p><%= mensaje %></p>
  <div class="acciones-formulario">
    <% if (entradaMenu && !esPanel) { %>
      <a class="boton" href="<%= entradaMenu[1].ruta %>">Volver a <%= entradaMenu[1].etiqueta %></a>
      <a class="boton boton--secundario" href="<%= SECCIONES.panel.ruta %>">Ir al panel</a>
    <% } else { %>
      <a class="boton" href="<%= SECCIONES.panel.ruta %>">Ir al panel</a>
    <% } %>
  </div>
</section>
<%- include('partials/footer') %>
