<%- include('../partials/header', { titulo: configuracion.titulo }) %>
<p><a href="/reportes">← Volver a reportes</a></p>
<h1><%= configuracion.titulo %></h1>
<% if (reporte === 'asistencia' || reporte === 'ingresos') { %>
  <form class="filtros tarjeta" method="GET" action="/reportes/<%= reporte %>">
    <label>Desde <input type="date" name="desde" value="<%= filtro.desde %>"></label>
    <label>Hasta <input type="date" name="hasta" value="<%= filtro.hasta %>"></label>
    <% if (reporte === 'asistencia') { %>
      <label>Tipo de evento
        <select name="tipo">
        <% [['', 'Todos'], ['culto', 'Culto'], ['reunion', 'Reunión'], ['actividad', 'Actividad'], ['administrativo', 'Administrativo']].forEach(o => { %>
          <option value="<%= o[0] %>" <%= filtro.tipoEvento === o[0] ? 'selected' : '' %>><%= o[1] %></option>
        <% }) %>
        </select>
      </label>
    <% } %>
    <button type="submit" class="boton">Filtrar</button>
  </form>
<% } %>
<% const parametros = new URLSearchParams();
   if (filtro.desde) parametros.set('desde', filtro.desde);
   if (filtro.hasta) parametros.set('hasta', filtro.hasta);
   if (reporte === 'asistencia' && filtro.tipoEvento) parametros.set('tipo', filtro.tipoEvento);
   const sufijo = parametros.toString(); %>
<p><a class="boton" href="/reportes/<%= reporte %>/excel<%= sufijo ? '?' + sufijo : '' %>">Descargar Excel</a></p>
<p class="sub"><%= filas.length %> resultado(s).</p>
<% if (filas.length === 0) { %>
  <section class="tarjeta">No hay registros para mostrar.</section>
<% } else { %>
  <div class="tabla-scroll"><table class="tabla">
    <thead><tr>
      <% configuracion.columnas.forEach(([key, titulo]) => { %><th scope="col"><%= titulo %></th><% }) %>
    </tr></thead>
    <tbody>
      <% filas.forEach(fila => { %><tr>
        <% configuracion.columnas.forEach(([key]) => { %><td>
          <% if (reporte === 'ingresos' && key === 'total') { %>
            <%= Number(fila[key]).toLocaleString('es-MX', { style: 'currency', currency: 'MXN' }) %>
          <% } else { %><%= fila[key] == null ? '—' : fila[key] %><% } %>
        </td><% }) %>
      </tr><% }) %>
    </tbody>
  </table></div>
<% } %>
<%- include('../partials/footer') %>
