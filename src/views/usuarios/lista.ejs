<%- include('../partials/header', { titulo: 'Usuarios' }) %>
<h1>Usuarios</h1>

<% if (puedeEditar) { %>
  <p class="acciones-formulario"><a class="boton boton--nuevo" href="/usuarios/nuevo">Nuevo usuario</a></p>
<% } %>

<% if (!usuarios.length) { %>
  <p class="sub">No hay usuarios registrados.</p>
<% } else { %>
<div class="tabla-scroll">
  <table class="tabla">
    <thead>
      <tr>
        <th scope="col">Nombre</th>
        <th scope="col">Correo</th>
        <th scope="col">Rol</th>
        <th scope="col">Miembro vinculado</th>
        <th scope="col">Estado</th>
        <% if (puedeEditar) { %><th scope="col">Acciones</th><% } %>
      </tr>
    </thead>
    <tbody>
      <% usuarios.forEach(u => { %>
        <tr>
          <td><%= u.nombre %></td>
          <td><%= u.correo %></td>
          <td><%= u.rol %></td>
          <td><%= u.miembro || '—' %></td>
          <td>
            <span class="etiqueta <%= u.activo === 1 ? 'etiqueta--activo' : 'etiqueta--inactivo' %>">
              <%= u.activo === 1 ? 'Activo' : 'Inactivo' %>
            </span>
          </td>
          <% if (puedeEditar) { %>
          <td class="acciones">
            <a class="accion-enlace" href="/usuarios/<%= u.id %>/editar">Editar</a>
            <% if (u.activo === 1) { %>
            <form method="POST" action="/usuarios/<%= u.id %>/desactivar" class="form-desactivar" data-nombre="<%= u.nombre %>">
              <button type="submit" class="accion-boton">Desactivar</button>
            </form>
            <% } %>
          </td>
          <% } %>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
<% } %>
<%- include('../partials/footer') %>
