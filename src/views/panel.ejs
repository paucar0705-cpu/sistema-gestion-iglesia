<%- include('partials/header', { titulo: 'Panel' }) %>
<h1>Panel principal</h1>

<div class="indicadores">
  <div class="tarjeta indicador">
    <div class="aurelia-indicador-icono"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="8.5" cy="8.5" r="3"/><circle cx="16.5" cy="9.5" r="2.4"/><path d="M3 20c0-3.3 2.5-5.8 5.5-5.8S14 16.7 14 20"/><path d="M15.2 14.4c2.3.1 4.6 1.8 4.6 5.6"/></svg></div>
    <span>Miembros activos</span><strong><%= indicadores.miembros_activos %></strong>
  </div>
  <div class="tarjeta indicador">
    <div class="aurelia-indicador-icono"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="3.5" y="5" width="17" height="16" rx="2"/><path d="M3.5 10h17"/><path d="M8 3v4"/><path d="M16 3v4"/></svg></div>
    <span>Próximos eventos</span><strong><%= indicadores.proximos_eventos %></strong>
  </div>
  <div class="tarjeta indicador">
    <div class="aurelia-indicador-icono"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="5" y="4" width="14" height="17" rx="2"/><path d="M9 4V3a1 1 0 011-1h4a1 1 0 011 1v1"/><path d="M8.5 13l2.3 2.3L15.5 11"/></svg></div>
    <span>Asistencias registradas</span><strong><%= indicadores.asistencias_registradas %></strong>
  </div>
  <div class="tarjeta indicador">
    <div class="aurelia-indicador-icono"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 20s-7-4.5-9.2-9A5 5 0 0112 6a5 5 0 019.2 5c-2.2 4.5-9.2 9-9.2 9z"/></svg></div>
    <span>Ministerios</span><strong><%= indicadores.ministerios_activos %></strong>
  </div>
  <% if (ingresosMes !== null) { %>
    <div class="tarjeta indicador indicador--dinero">
      <div class="aurelia-indicador-icono"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="8.5"/><path d="M12 7v10"/><path d="M15 9.5c0-1.4-1.3-2.5-3-2.5s-3 1-3 2.3c0 2.8 6 1.3 6 4.2 0 1.4-1.3 2.5-3 2.5s-3-1-3-2.3"/></svg></div>
      <span>Ingresos del mes</span>
      <strong>$<%= ingresosMes.toLocaleString('es-MX', { minimumFractionDigits: 2 }) %></strong>
    </div>
  <% } %>
</div>

<% if (puedeVerAsistencias) { %>
  <section class="tarjeta grafica">
    <h2>Asistencia por evento</h2>
    <% if (errorAsistencias) { %>
      <p class="alerta" role="alert">No se pudieron cargar los datos de asistencia. Intenta de nuevo más tarde.</p>
    <% } else if (!asistenciasPorEvento.length) { %>
      <p class="sub">Aún no hay asistencias registradas.</p>
    <% } else { %>
      <p class="sub grafica__sub">Presentes y ausentes en los últimos eventos con registro.</p>
      <p class="alerta" id="graficaError" role="alert" hidden>No se pudo cargar la gráfica. Puedes consultar los datos en la tabla.</p>
      <noscript><p class="alerta">La gráfica necesita JavaScript. Puedes consultar los datos en la tabla.</p></noscript>
      <div class="grafica__lienzo" id="graficaContenedor" hidden>
        <canvas id="graficaAsistencias" role="img"
          aria-label="Gráfica de barras de presentes y ausentes por evento. Los datos están en la tabla siguiente."
          data-asistencias="<%= JSON.stringify(asistenciasPorEvento) %>"></canvas>
      </div>
      <details class="grafica__datos" id="graficaDatos">
        <summary>Ver datos en tabla</summary>
        <div class="tabla-scroll">
          <table class="tabla">
            <thead><tr><th>Evento</th><th>Fecha</th><th>Presentes</th><th>Ausentes</th></tr></thead>
            <tbody>
              <% asistenciasPorEvento.forEach(e => { %>
                <tr><td><%= e.titulo %></td><td><%= e.fecha %></td><td><%= e.presentes %></td><td><%= e.ausentes %></td></tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </details>
      <script defer src="https://cdn.jsdelivr.net/npm/chart.js@4.4.9/dist/chart.umd.js"
        integrity="sha384-4W8gMhOYqk0FPg9sAMkb3g/P2fXtzbUyDUUgMlA1EEig8z/U/13EYUjErc1H382b"
        crossorigin="anonymous"></script>
      <script defer src="/js/panel-graficas.js"></script>
    <% } %>
  </section>
<% } %>

<div class="columnas">
  <section class="tarjeta">
    <h2><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="3.5" y="5" width="17" height="16" rx="2"/><path d="M3.5 10h17"/><path d="M8 3v4"/><path d="M16 3v4"/></svg>Próximos eventos</h2>
    <% if (!proximosEventos.length) { %><p class="sub">Sin eventos programados.</p><% } %>
    <ul class="lista">
      <% proximosEventos.forEach(e => { %>
        <li><strong><%= e.titulo %></strong><span><%= e.fecha %> <%= e.hora || '' %> · <%= e.lugar || '' %></span></li>
      <% }) %>
    </ul>
  </section>
  <section class="tarjeta">
    <h2><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 11v2a2 2 0 002 2h1l9 5V4l-9 5H5a2 2 0 00-2 2z"/><path d="M17 9.5a4 4 0 010 5"/></svg>Avisos</h2>
    <ul class="lista">
      <% anuncios.forEach(a => { %>
        <li class="<%= a.importante ? 'importante' : '' %>"><strong><%= a.titulo %></strong><span><%= a.contenido %></span></li>
      <% }) %>
    </ul>
  </section>
</div>
<%- include('partials/footer') %>
