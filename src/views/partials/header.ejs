<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof titulo !== 'undefined' ? titulo + ' · ' : '' %><%= iglesia.nombre %></title>
  <link rel="stylesheet" href="/css/estilos.css">
  <link rel="stylesheet" href="/css/menu-movil.css">
  <link rel="stylesheet" href="/css/tema-aurelia.css">
  <script defer src="/js/reloj.js"></script>
  <script>document.documentElement.classList.add('js');</script>
</head>
<body>
<% if (usuario) { %>
<%
  const aureliaAhora = new Date();
  const aureliaFecha = aureliaAhora.toLocaleDateString('es-ES', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
  const aureliaFechaTexto = aureliaFecha.charAt(0).toUpperCase() + aureliaFecha.slice(1);
  const aureliaIniciales = usuario.nombre.trim().split(/\s+/).slice(0, 2).map((p) => p[0].toUpperCase()).join('');
  const aureliaMeses = ['ene', 'feb', 'mar', 'abr', 'may', 'jun', 'jul', 'ago', 'sep', 'oct', 'nov', 'dic'];
  const aureliaFechaCorta = `${aureliaAhora.getDate()} ${aureliaMeses[aureliaAhora.getMonth()]} ${aureliaAhora.getFullYear()}`;
  const aureliaHoraCorta = aureliaAhora.toLocaleTimeString('es-MX', { hour: '2-digit', minute: '2-digit', hour12: false });

  // Mapa clave -> SVG fijo (nunca datos de BD: "clave" viene de SECCIONES en
  // src/config/permisos.js, no de entrada de usuario). Todos con
  // aria-hidden/focusable="false" porque son decorativos.
  const AURELIA_SVG_ATR = 'width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"';
  const aureliaIconos = {
    panel: `<svg ${AURELIA_SVG_ATR}><rect x="3" y="3" width="8" height="8" rx="1.5"/><rect x="13" y="3" width="8" height="8" rx="1.5"/><rect x="3" y="13" width="8" height="8" rx="1.5"/><rect x="13" y="13" width="8" height="8" rx="1.5"/></svg>`,
    usuarios: `<svg ${AURELIA_SVG_ATR}><circle cx="12" cy="8" r="3.5"/><path d="M5 20c0-3.5 3-6 7-6s7 2.5 7 6"/></svg>`,
    miembros: `<svg ${AURELIA_SVG_ATR}><circle cx="8.5" cy="8.5" r="3"/><circle cx="16.5" cy="9.5" r="2.4"/><path d="M3 20c0-3.3 2.5-5.8 5.5-5.8S14 16.7 14 20"/><path d="M15.2 14.4c2.3.1 4.6 1.8 4.6 5.6"/></svg>`,
    asistencias: `<svg ${AURELIA_SVG_ATR}><rect x="5" y="4" width="14" height="17" rx="2"/><path d="M9 4V3a1 1 0 011-1h4a1 1 0 011 1v1"/><path d="M8.5 13l2.3 2.3L15.5 11"/></svg>`,
    eventos: `<svg ${AURELIA_SVG_ATR}><rect x="3.5" y="5" width="17" height="16" rx="2"/><path d="M3.5 10h17"/><path d="M8 3v4"/><path d="M16 3v4"/></svg>`,
    ministerios: `<svg ${AURELIA_SVG_ATR}><path d="M12 20s-7-4.5-9.2-9A5 5 0 0112 6a5 5 0 019.2 5c-2.2 4.5-9.2 9-9.2 9z"/></svg>`,
    donaciones: `<svg ${AURELIA_SVG_ATR}><rect x="4" y="9" width="16" height="12" rx="1.5"/><path d="M4 9h16v3H4z"/><path d="M12 9v12"/><path d="M12 9c-1.6-3-6-3-6 .2 0 1.5 1.5 1.5 3 1.5"/><path d="M12 9c1.6-3 6-3 6 .2 0 1.5-1.5 1.5-3 1.5"/></svg>`,
    anuncios: `<svg ${AURELIA_SVG_ATR}><path d="M3 11v2a2 2 0 002 2h1l9 5V4l-9 5H5a2 2 0 00-2 2z"/><path d="M17 9.5a4 4 0 010 5"/></svg>`,
    reportes: `<svg ${AURELIA_SVG_ATR}><path d="M4 20V10"/><path d="M11 20V4"/><path d="M18 20v-7"/><path d="M3 20h18"/></svg>`,
    configuracion: `<svg ${AURELIA_SVG_ATR}><circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M4.2 4.2l2.1 2.1M17.7 17.7l2.1 2.1M2 12h3M19 12h3M4.2 19.8l2.1-2.1M17.7 6.3l2.1-2.1"/></svg>`,
    generico: `<svg ${AURELIA_SVG_ATR}><path d="M12 3l2.6 5.6 6.2.6-4.6 4.2 1.3 6.1L12 16.9 6.5 19.5l1.3-6.1-4.6-4.2 6.2-.6z"/></svg>`,
  };
%>
<div class="layout">
  <aside class="menu">
    <div class="menu__cabecera">
      <div class="menu__marca"><%= iglesia.nombre %></div>
      <button type="button" id="botonMenu" class="boton-menu" aria-expanded="false" aria-controls="menuPanel" aria-label="Abrir menú">
        <svg class="boton-menu__icono" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false">
          <g class="boton-menu__trazo-abrir">
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </g>
          <g class="boton-menu__trazo-cerrar">
            <line x1="5" y1="5" x2="19" y2="19"></line>
            <line x1="19" y1="5" x2="5" y2="19"></line>
          </g>
        </svg>
      </button>
    </div>
    <div class="menu__panel" id="menuPanel">
      <div class="aurelia-marca">
        <img src="/img/aurelia-logo.png" alt="Aurelia" width="56" height="56" class="aurelia-marca__logo">
        <span class="aurelia-marca__eslogan">Tecnología al servicio de la comunidad</span>
      </div>
      <nav>
        <% menu.forEach(([clave, s]) => { %>
          <a href="<%= s.ruta %>" class="<%= rutaActual.startsWith(s.ruta) ? 'activo' : '' %>"><%- aureliaIconos[clave] || aureliaIconos.generico %><span><%= s.etiqueta %></span></a>
        <% }) %>
      </nav>
      <div class="aurelia-versiculo">
        <strong>Versículo</strong>
        <p>«Lámpara es a mis pies tu palabra, y lumbrera a mi camino.» — Salmo 119:105</p>
      </div>
      <div class="menu__usuario">
        <strong><%= usuario.nombre %></strong>
        <span><%= usuario.rol %></span>
        <form method="POST" action="/logout"><button type="submit">Cerrar sesión</button></form>
      </div>
    </div>
  </aside>
  <div class="menu__scrim" id="menuScrim" hidden></div>
  <main class="contenido" id="contenidoPrincipal">
    <header class="aurelia-encabezado">
      <div class="aurelia-encabezado__texto">
        <p class="aurelia-encabezado__iglesia"><%= iglesia.nombre %></p>
        <p class="aurelia-encabezado__saludo">Bienvenido, <%= usuario.nombre %></p>
        <p class="aurelia-encabezado__fecha"><%= aureliaFechaTexto %></p>
      </div>
      <div class="aurelia-encabezado__extras">
        <div class="aurelia-reloj">
          <span class="aurelia-reloj__fecha"><%= aureliaFechaCorta %></span>
          <time class="aurelia-reloj__hora" id="aureliaHora" datetime="<%= aureliaHoraCorta %>"><%= aureliaHoraCorta %></time>
        </div>
        <div class="aurelia-avatar" aria-hidden="true"><%= aureliaIniciales %></div>
      </div>
    </header>
<% } else { %>
<main class="contenido contenido--solo">
<% } %>
