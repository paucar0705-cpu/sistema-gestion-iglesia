<%- include('partials/header', { titulo: 'Iniciar sesión' }) %>
<section class="tarjeta login aurelia-login">
  <img src="/img/aurelia-logo.png" alt="Aurelia" width="72" height="72" class="aurelia-login__logo">
  <h1><%= iglesia.nombre %></h1>
  <%- include('partials/eslogan') %>
  <p class="sub">Inicia sesión para continuar</p>
  <p id="mensajeError" class="alerta" role="alert"<% if (!error) { %> hidden<% } %>><%= error || '' %></p>
  <form method="POST" action="/login" novalidate>
    <label>Correo electrónico
      <input type="email" name="correo" id="correo" value="<%= correo %>" required autofocus>
    </label>
    <label>Contraseña
      <input type="password" name="password" id="password" required>
    </label>
    <button type="submit" class="boton">Entrar</button>
    <a class="enlace-sutil" href="/recuperar">¿Olvidaste tu contraseña?</a>
  </form>
</section>
<%- include('partials/footer') %>
