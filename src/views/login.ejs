<%- include('partials/header', { titulo: 'Iniciar sesión' }) %>
<section class="tarjeta login">
  <h1><%= iglesia.nombre %></h1>
  <p class="sub">Inicia sesión para continuar</p>
  <% if (error) { %><p class="alerta"><%= error %></p><% } %>
  <form method="POST" action="/login">
    <label>Correo electrónico
      <input type="email" name="correo" value="<%= correo %>" required autofocus>
    </label>
    <label>Contraseña
      <input type="password" name="password" required>
    </label>
    <button type="submit" class="boton">Entrar</button>
  </form>
  <!-- TODO Persona 2: enlace a /recuperar -->
</section>
<%- include('partials/footer') %>
